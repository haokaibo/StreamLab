# Copy to .env (git-ignored). Local development credentials only; never reuse real ones.
# The Flink SQL files and flink/client-conf/config.yaml hard-code the same dev credentials;
# tests/test_compose.py fails if they drift apart.
COMPOSE_PROJECT_NAME=streamlab

# --- Image pins. Verify every tag exists for linux/arm64 before the first build
# (see docs/KNOWN-UNKNOWNS.md, items K-01..K-04). ---
KAFKA_IMAGE=apache/kafka:4.4.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.9.11
POSTGRES_IMAGE=postgres:17.12
GRAFANA_IMAGE=grafana/grafana:13.3.1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:latest

# --- Flink build args (flink/Dockerfile). Connector versions must match the Flink minor. ---
# Flink 2.3.0 is the newest release, but the JDBC connector stops at 4.1.0-2.2, so the
# stack is pinned to Flink 2.2.1. Bump both together once a 2.3 connector ships (K-14).
FLINK_VERSION=2.2.1
FLINK_KAFKA_CONNECTOR_VERSION=5.0.0-2.2
FLINK_JDBC_CONNECTOR_VERSION=4.1.0-2.2
POSTGRES_JDBC_VERSION=42.7.7

# --- Dev credentials ---
POSTGRES_USER=streamlab
POSTGRES_PASSWORD=streamlab_dev
POSTGRES_DB=streamlab
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
